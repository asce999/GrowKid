# One ignore file for the whole repo: rules without a leading slash apply in client/ and server/ too.

# OS
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Secrets: client/.env, server/.env, server/.env.test
.env
.env.*
*.local
!.env.example

# Dependencies and build output
node_modules/
dist/
dist-ssr/
build/

# Logs
logs/
*.log

# Word and Excel lock files, created while a document is open
~$*

# Browser automation and end-to-end test output
.playwright-mcp/
test-results/
playwright-report/

# Working brief for the current build phase, rewritten every phase
/prompt.md
