# One of development, test or production; the server refuses to start without it.
NODE_ENV=development
# The port Node listens on, on 127.0.0.1 only.
PORT=3000
# Keep UTC. A family's day follows its country (S11), so no code may depend on the server's own zone.
TZ=UTC
# The PostgreSQL connection string.
DATABASE_URL=
# At least 32 characters. Make one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# An absolute path where proof files are kept. The server refuses one inside the repo or inside a OneDrive folder:
# proof files are children's photos, and a synced folder is copied to another company.
UPLOAD_DIR=
# Optional, development and tests only. Set to 1 to let the X-Clock-Days header move the server's clock (the client's ?clock=<days>
# switch sends it). Leave it out otherwise: with it on, anyone who can reach the server can shift every family's days.
# DEV_CLOCK=1
# Only for `npm run moderator` (A4). Set both in the shell for that one command rather than here; the script never reads argv.
# The password needs at least 20 characters; make it with a password manager.
# MODERATOR_EMAIL=
# MODERATOR_PASSWORD=
# Makes a new authenticator secret and prints its otpauth:// link once; a new moderator gets one anyway (T1).
# MODERATOR_TOTP=new
# Removes the moderator with that address (T1).
# MODERATOR_REMOVE=1
