{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node --env-file=.env src/index.js",
    "pretest": "node --env-file=.env.test scripts/test-db.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1 \"test/*.test.js\"",
    "lint": "oxlint",
    "seed": "node --env-file=.env prisma/seed.js",
    "moderator": "node --env-file=.env scripts/moderator.js",
    "pause-family": "node --env-file=.env scripts/pause-family.js"
  },
  "private": true,
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "oxlint": "^1.91.0",
    "prisma": "^6.19.3"
  }
}
